# URL pública do site (canonical, sitemap, Open Graph). Sem barra no final.
NEXT_PUBLIC_SITE_URL=

# ---- Entrega do formulário de contato (configure ao menos um canal) ----
# E-mail via Resend (https://resend.com). O domínio do remetente precisa estar verificado.
RESEND_API_KEY=
CONTACT_TO_EMAIL=          # um ou mais, separados por vírgula
CONTACT_FROM_EMAIL=        # ex.: "KI COMPANY <site@seudominio.com.br>"

# Webhook (CRM, n8n, Make, Zapier ou backend próprio). Recebe POST JSON.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=    # opcional: assina o corpo com HMAC-SHA256 no header X-Signature-SHA256

# ---- Dados institucionais (deixe vazio o que não deve aparecer) ----
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=   # só dígitos com DDI, ex.: 5521999999999
NEXT_PUBLIC_COMPANY_CITY=
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_CNPJ=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=

# Pré-visualização de produtos marcados como "hidden" (ex.: Avvia). Nunca use "true" em produção.
PREVIEW_HIDDEN_PRODUCTS=
